# Safe, non-secret example overrides. Copy to terraform.tfvars only for local CLI use.
aws_region         = "eu-central-1"
cluster_name       = "sports-store-cluster"
vpc_cidr           = "10.0.0.0/16"
github_organization = "sports-store-devops-team"

github_repositories = [
  "sports-store-frontend",
  "sports-store-auth-service",
  "sports-store-catalog-service",
  "sports-store-cart-service",
  "sports-store-order-service",
  "sports-store-payment-service",
]
